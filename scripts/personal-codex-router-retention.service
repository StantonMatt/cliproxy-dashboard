[Unit]
Description=Archive and verify old raw router usage before pruning
After=local-fs.target

[Service]
Type=oneshot
User=cliproxyapi
Group=cliproxyapi
ExecStart=/usr/bin/python3 /opt/personal-codex-router/retain-usage.py
StateDirectory=personal-codex-router
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
