[Unit]
Description=Renew private preview Tailscale TLS certificate
After=tailscaled.service
Requires=tailscaled.service

[Service]
Type=oneshot
User=root
UMask=0077
StateDirectory=personal-codex-router-preview-tls
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/personal-codex-router/renew-preview-cert.py
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
